# AI captain for Westerly on Arc testnet. cp .env.example .env, fill CAPTAIN_PRIVATE_KEY, then:
#   set -a; . ./.env; set +a; npm run captain:once   (or captain:rogue to watch the contract block a bad trade)
CAPTAIN_PRIVATE_KEY=
RPC_URL=https://rpc.testnet.arc.io
BOAT=0x6f762E474d9aA387631f2F32013B8bDb6d0A66e5
ORACLE=0x712f8c439e455e928b2f84c6f389d77e93c980f0
USDC=0x3600000000000000000000000000000000000000
USYC=0x7cfe546361594b24790d5f073a76a03217f0ee6d
EURC=0x579eefde3f46de5cef4c75c652eee372e4c0e808
CIRBTC=0x56176b92852793a93f1783eb29232fa7c899b1bc
# Gemini Prediction Markets signal: "Fed decision in December?"
GEMINI_EVENT=FED261211
GEMINI_CONTRACT_MATCH="Hike 25bps"
ODDS_TRIGGER=0.7
MOVE_FRACTION=0.5
# Maximum execution loss vs oracle value: 100 basis points = 1% (0 to 500).
SLIPPAGE_BPS=100
# Optional: POST each log line to the app (https://<your-app>/api/captain-log)
LOG_WEBHOOK=
