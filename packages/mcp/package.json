  "bin": { "boats-mcp": "src/server.ts" },
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@boats/sdk": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "viem": "2.21.54",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
